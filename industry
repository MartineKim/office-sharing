let lastSearch={keyword:"",result:null};
function matchIndustry(keyword){const q=keyword.trim().toLowerCase();return industryData.find(item=>item.code.toLowerCase()===q||item.name.toLowerCase().includes(q)||item.keywords.some(k=>k.toLowerCase().includes(q)||q.includes(k.toLowerCase())));}
function searchIndustry(){const input=document.getElementById("industrySearch");const keyword=input.value.trim();if(!keyword){alert("업종명 또는 업종코드를 입력해주세요.");return;}const result=matchIndustry(keyword);lastSearch={keyword,result};renderResult(result,keyword);logSearch(keyword,result);}
function renderResult(r,k){const a=document.getElementById("resultArea");if(!r){a.innerHTML=`<div class="text-center py-8"><div class="text-5xl">🔎</div><h2 class="mt-4 text-2xl font-extrabold">현재 DB에서 찾지 못했습니다.</h2><p class="mt-3 text-slate-600">“${escapeHtml(k)}” 업종은 상담을 통해 확인해드릴 수 있습니다.</p><button onclick="openConsultModal()" class="mt-7 px-6 py-4 bg-blue-700 text-white rounded-xl font-bold">이 업종 상담하기</button></div>`;return;}const c=r.statusClass==="green"?"bg-green-100 text-green-700":"bg-amber-100 text-amber-700";a.innerHTML=`<p class="text-sm text-slate-500">업종 상세 분석 리포트</p><div class="mt-2 flex flex-wrap gap-3 items-center"><h2 class="text-3xl font-extrabold">${r.name}</h2><span class="px-3 py-1 rounded-full text-sm font-bold ${c}">${r.status}</span></div><p class="mt-2 text-slate-500">업종코드 ${r.code}</p><div class="mt-7 grid gap-4"><div class="p-5 bg-slate-50 rounded-2xl"><h3 class="font-bold">BizStory Comment</h3><p class="mt-2 text-slate-600 leading-relaxed">${r.comment}</p></div><div class="p-5 border rounded-2xl"><h3 class="font-bold">사업자등록 체크사항</h3><p class="mt-2 text-slate-600">${r.check}</p></div><div class="p-5 border rounded-2xl"><h3 class="font-bold">세무 TIP</h3><p class="mt-2 text-slate-600">${r.tip}</p></div></div><button onclick="openConsultModal()" class="mt-7 w-full py-4 bg-blue-700 text-white rounded-xl font-bold">이 업종으로 비상주 상담하기</button>`;}
function escapeHtml(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function logSearch(keyword,result){const p=new URLSearchParams(location.search);fetch(APPS_SCRIPT_URL,{method:"POST",mode:"no-cors",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify({type:"industrySearch",keyword,matchedName:result?result.name:"결과없음",matchedCode:result?result.code:"",status:result?result.status:"결과없음",channel:p.get("utm_source")||"직접유입",campaign:p.get("utm_campaign")||""})}).catch(console.error);}
function openConsultModal(){const m=document.getElementById("consultModal");const msg=document.getElementById("message");if(lastSearch.keyword)msg.value=lastSearch.result?`업종: ${lastSearch.result.name} (${lastSearch.result.code})\n비상주 등록 상담을 원합니다.`:`검색 업종: ${lastSearch.keyword}\n비상주 등록 가능 여부 상담을 원합니다.`;m.classList.remove("hidden");document.body.classList.add("overflow-hidden");}function closeConsultModal(){document.getElementById("consultModal").classList.add("hidden");document.body.classList.remove("overflow-hidden");}
